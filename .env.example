# Variables que usa docker-compose.yml para crear la base de datos.
# Copia este archivo como .env (en esta misma carpeta raíz).
# La contraseña debe ser LA MISMA que pongas en server/.env (DB_PASSWORD).
POSTGRES_USER=mt_admin
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=mt_tienda
# 5433 para no chocar con otro PostgreSQL que ya tengas en el 5432
POSTGRES_PORT=5433
