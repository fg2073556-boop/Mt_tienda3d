# Copia este archivo como server/.env
PORT=3001

# Conexión a PostgreSQL (los mismos datos que el .env de la raíz)
DB_HOST=localhost
DB_PORT=5433
DB_USER=mt_admin
DB_PASSWORD=cambia-esta-clave
DB_NAME=mt_tienda

# Clave para firmar los tokens de sesión. Pon una frase larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta

# Cuentas del panel que crea "npm run crear-usuarios" (contraseñas de 8+ caracteres)
# Administrador: puede todo (alta, edición y baja de productos)
ADMIN_NAME=Administrador M&T
ADMIN_EMAIL=admin@mt-tienda.test
ADMIN_PASSWORD=cambia-esta-clave
# Vendedor: atiende pedidos y ajusta existencias
SELLER_NAME=Vendedor M&T
SELLER_EMAIL=vendedor@mt-tienda.test
SELLER_PASSWORD=cambia-esta-clave

# Dirección del frontend (para permitir las peticiones)
CLIENT_URL=http://localhost:5173

# Asesor con IA: crea tu llave en https://aistudio.google.com
# Sin llave, el asesor funciona con reglas simples.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Avisos de reposición por correo (cuando algo se está acabando).
# A quién le llegan y el WhatsApp del proveedor se configuran en el panel → Reposición.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
# NUNCA escribas estas claves en el código ni las subas a GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REMITENTE=Avisos M&T
# Cada cuántos segundos revisa si hay alertas nuevas para mandar (mínimo 15)
AVISOS_CADA_SEG=60
